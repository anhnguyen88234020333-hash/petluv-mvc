<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetLuv</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetLuv.styles.css" asp-append-version="true" />
</head>
<body>
        <header class="header">
            <img src="~/images/logo/logo.svg" alt="logo" width="100">

            <nav>
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a asp-controller="Product" asp-action="Index">Sản phẩm</a>
            <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>

            @* Đoạn logic kiểm tra đăng nhập Kim Anh *@
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span style="color: #512773; font-weight: bold; margin-left: 15px;">
                    Xin chào, @User.Identity.Name!
                </span>
                <a asp-controller="Account" asp-action="Logout" style="margin-left: 10px; color: #274753; font-size: 0.9em;">(Đăng xuất)</a>
            }
            else
            {
                @* Kim Anh thêm chỗ này để hiện trên trang chủ *@
                <a asp-controller="Account" asp-action="Login">Tài khoản</a>
            }
            </nav>
        </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PetLuv - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
