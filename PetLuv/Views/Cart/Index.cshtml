@model IEnumerable<PetLuv.Models.Cart>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<style>
    .cart-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 5px;
    }

    .table th {
        background-color: #f8f9fa;
    }

    .total-price {
        color: #d9534f;
        font-weight: bold;
        font-size: 1.2em;
    }
</style>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">🛒 GIỎ HÀNG CỦA BẠN</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Giỏ hàng của bạn đang trống. <br />
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm p-3 mb-5 bg-white rounded">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 15%">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th style="width: 10%">Số lượng</th>
                        <th>Thành tiền</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@Url.Content(item.Product.ImageURL)" class="cart-img" alt="@item.Product.ProductName">
                            </td>
                            <td><strong>@item.Product.ProductName</strong></td>
                            <td>@item.Product.Price.ToString("N0") VNĐ</td>
                            <td>
                                <span class="badge bg-secondary p-2">@item.Quantity</span>
                            </td>
                            <td class="price-text">
                                @((item.Product.Price * item.Quantity).ToString("N0")) VNĐ
                            </td>
                            <td class="text-center">
                                <a asp-controller="Cart" asp-action="RemoveFromCart" asp-route-cartId="@item.CartId"
                                   class="btn btn-danger btn-sm" onclick="return confirm('Ngọc có chắc muốn xóa món này không?')">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Tiếp tục mua hàng</a>
                <div class="text-end">
                    <p class="mb-1">Tổng cộng thanh toán:</p>
                    <span class="total-price">@Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0") VNĐ</span>
                    <br />
                <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary">
    <i class="bi bi-credit-card"></i> Thanh toán ngay
</a>
                </div>
            </div>
        </div>
    }
</div>