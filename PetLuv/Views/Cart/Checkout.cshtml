@model IEnumerable<PetLuv.Models.Cart>

@{
    ViewData["Title"] = "Thông tin thanh toán - PetLuv";
}

<div class="container mt-5" style="padding-bottom: 100px; font-family: 'Nunito', sans-serif;">
    <h2 class="text-center mb-4 fw-bold" style="color: #512773;">THÔNG TIN THANH TOÁN</h2>

    <div class="row">
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 p-4" style="border-radius: 20px; background: white;">
                <form asp-action="ProcessOrder" method="post" id="checkoutForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên người nhận</label>
                        <input name="CustomerName" class="form-control" placeholder="Nhập họ tên..." required style="border-radius: 10px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input name="Phone" class="form-control" placeholder="Nhập số điện thoại..." required style="border-radius: 10px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                        <textarea name="Address" class="form-control" rows="3" placeholder="Địa chỉ cụ thể..." required style="border-radius: 10px;"></textarea>
                    </div>

                    <div class="mb-4 p-3 border rounded" style="background-color: #FFF9F3; border-color: #FFC55C !important; border-radius: 15px !important;">
                        <label class="form-label"><strong>Phương thức thanh toán:</strong></label>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="cod" value="COD" checked style="cursor: pointer;">
                            <label class="form-check-label fw-bold" for="cod" style="color: #274753; cursor: pointer;">
                                💵 Thanh toán khi nhận hàng (COD)
                            </label>
                            <div class="small text-muted italic ms-1">Bạn sẽ thanh toán tiền mặt trực tiếp khi nhận hàng.</div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="vnpay" value="VNPAY" style="cursor: pointer;">
                            <label class="form-check-label fw-bold" for="vnpay" style="color: #512773; cursor: pointer;">
                                💳 Thanh toán qua cổng VNPAY (Thử nghiệm Sandbox)
                            </label>
                            <div class="small text-muted ms-1">Hỗ trợ quét mã QR hoặc thẻ ATM nội địa để thử nghiệm luồng tiền.</div>
                        </div>
                    </div>

                    <button type="submit" class="btn text-white fw-bold btn-lg w-100 mt-2 py-3 shadow-sm" style="background-color: #512773; border-radius: 50px;">
                        XÁC NHẬN ĐẶT HÀNG 🐾
                    </button>
                </form>
            </div>
        </div> <div class="col-md-5 mb-4">
            <div class="card shadow-sm p-4 border-0" style="border-radius: 20px; background-color: #FFF1E8;">
                <h4 class="fw-bold" style="color: #512773;">Đơn hàng của bạn</h4>
                <hr />
                <div class="order-items-list">
                    @foreach (var item in Model)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold text-secondary">@item.Product.ProductName (x@(item.Quantity))</span>
                            <span class="fw-bold" style="color: #274753;">@((item.Product.Price * item.Quantity).ToString("N0")) đ</span>
                        </div>
                    }
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <strong style="color: #512773; font-size: 1.1rem;">Tổng cộng:</strong>
                    <strong class="text-danger" style="font-size: 1.4rem;">@Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0") đ</strong>
                </div>
            </div>
        </div>
    </div>
</div> ```
