@model IEnumerable<PetLuv.Models.Cart>

<div class="container mt-5" style="padding-bottom: 100px;">
    <h2 class="text-center mb-4">THÔNG TIN THANH TOÁN</h2>
    
    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm p-4">
                <form asp-action="ProcessOrder" method="post">
                    <div class="mb-3">
                        <label class="form-label">Họ và tên người nhận</label>
                        <input name="CustomerName" class="form-control" placeholder="Nhập họ tên..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input name="Phone" class="form-control" placeholder="Nhập số điện thoại..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ giao hàng</label>
                        <textarea name="Address" class="form-control" rows="3" placeholder="Địa chỉ cụ thể..." required></textarea>
                    </div>

                    <div class="mb-4 p-3 border rounded bg-light">
                        <label class="form-label"><strong>Phương thức thanh toán:</strong></label>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="cod" value="COD" checked>
                            <label class="form-check-label" for="cod">
                                Thanh toán khi nhận hàng (COD)
                            </label>
                            <div class="small text-muted italic">Bạn sẽ thanh toán tiền mặt khi nhận hàng.</div>
                        </div>
                        <div class="form-check disabled">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="momo" value="Momo" disabled>
                            <label class="form-check-label text-muted" for="momo">
                                Thanh toán qua chuyển khoản (Sắp ra mắt)
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-2">XÁC NHẬN ĐẶT HÀNG</button>
                </form>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm p-4 bg-light border-primary">
                <h4 class="text-primary">Đơn hàng của bạn</h4>
                <hr />
                @foreach (var item in Model)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>@item.Product.ProductName (x@(item.Quantity))</span>
                        <span>@((item.Product.Price * item.Quantity).ToString("N0")) VNĐ</span>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between">
                    <strong>Tổng cộng:</strong>
                    <strong class="text-danger" style="font-size: 1.2rem;">@Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0") VNĐ</strong>
                </div>
            </div>
        </div>
    </div>
</div>