@{
    ViewData["Title"] = "Kết quả thanh toán VNPAY";
}

<div class="container mt-5 text-center" style="max-width: 600px; font-family: 'Nunito', sans-serif;">
    <div class="card shadow border-0 p-5" style="border-radius: 20px; background-color: white;">
        <h2 class="fw-bold mb-4" style="color: #512773;">💳 KẾT QUẢ GIAO DỊCH VNPAY</h2>

        <div class="alert alert-info border-0 p-4 mb-4 fw-bold shadow-sm" style="border-radius: 12px; font-size: 1.1rem;">
            @ViewBag.Message
        </div>

        <a href="/" class="btn text-white fw-bold px-4 py-2 w-100" style="background-color: #FFC55C; color: #274753 !important; border-radius: 50px;">
            Quay lại Cửa hàng PetLuv 🐾
        </a>
    </div>
</div>