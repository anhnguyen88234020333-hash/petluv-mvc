@model IEnumerable<PetLuv.Models.Order>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">LỊCH SỬ ĐẶT HÀNG</h2>

    <div class="table-responsive shadow-sm p-3 mb-5 bg-white rounded">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Ngày Đặt</th>
                    <th>Người Nhận</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.OrderID</strong></td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.CustomerName</td>
                        <td class="text-danger fw-bold">@item.TotalAmount.ToString("N0") VNĐ</td>
                        <td>
                            @if(item.Status == 0) {
                                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                            } else {
                                <span class="badge bg-success">Đã giao</span>
                            }
                        </td>
                        <td>
                            <a href="/Cart/OrderDetail?id=@item.OrderID" class="btn btn-outline-info btn-sm">Xem chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>