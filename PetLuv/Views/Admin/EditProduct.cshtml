@model PetLuv.Models.Product
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4" style="max-width: 600px; font-family: 'Inter', sans-serif;">
    <div class="card shadow border-0 p-4" style="border-radius: 20px;">
        <h3 class="fw-bold text-center mb-4" style="color: #512773;">📝 CẬP NHẬT SẢN PHẨM</h3>

        <form asp-action="EditProduct" method="post">
            <input type="hidden" asp-for="ProductID" />

            <div class="mb-3">
                <label class="form-label fw-bold">Tên sản phẩm</label>
                <input asp-for="ProductName" class="form-control" required style="border-radius: 10px;" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tên danh mục</label>
                <input asp-for="Category" class="form-control" required style="border-radius: 10px;" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Giá bán (đ)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required style="border-radius: 10px;" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số lượng tồn kho</label>
                <input asp-for="Stock" type="number" class="form-control" required style="border-radius: 10px;" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tên tệp ảnh</label>
                <input asp-for="ImageURL" class="form-control" required style="border-radius: 10px;" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Mô tả chi tiết</label>
                <textarea asp-for="Description" class="form-control" rows="3" style="border-radius: 10px;"></textarea>
            </div>

            <div class="d-flex gap-3">
                <a asp-action="ProductsList" class="btn btn-secondary w-100 fw-bold py-2" style="border-radius: 10px;">Hủy bỏ</a>
                <button type="submit" class="btn text-white w-100 fw-bold py-2" style="background-color: #512773; border-radius: 10px;">Cập nhật</button>
            </div>
        </form>
    </div>
</div>