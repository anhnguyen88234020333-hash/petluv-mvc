@model IEnumerable<PetLuv.Models.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container mt-4" style="font-family: 'Inter', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #512773;">📦 QUẢN LÝ DANH SÁCH SẢN PHẨM</h2>
        <a asp-action="CreateProduct" class="btn text-white fw-bold px-4 py-2" style="background-color: #FFC107; border-radius: 10px;">
            ➕ Thêm sản phẩm mới
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
        <table class="table table-hover align-middle mb-0 text-center">
            <thead class="text-white" style="background-color: #512773;">
                <tr>
                    <th style="width: 10%;">Mã SP</th>
                    <th style="width: 45%;">Tên sản phẩm</th>
                    <th style="width: 15%;">Danh mục</th>
                    <th style="width: 15%;">Giá bán</th>
                    <th style="width: 15%;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.ProductID</td>
                        <td class="text-start fw-bold" style="padding-left: 20px;">@item.ProductName</td>
                        <td><span class="badge bg-secondary p-2">@item.Category</span></td>
                        <td class="text-danger fw-bold">@String.Format("{0:N0}", item.Price) đ</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="EditProduct" asp-route-id="@item.ProductID" class="btn btn-sm text-white" style="background-color: #6c757d; border-radius: 8px;">
                                    📝 Sửa
                                </a>
                                <form asp-action="DeleteProduct" asp-route-id="@item.ProductID" method="post" onsubmit="return confirm('Bồ có chắc muốn xóa sản phẩm này không?');" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-danger" style="border-radius: 8px;">
                                        🗑️ Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>