@{
    ViewData["Title"] = "Đổi Mật Khẩu - PetLuv";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow border border-info p-4">
        <h3 class="text-center mb-4" style="color: #512773; font-weight: bold;">🔐 Đổi Mật Khẩu</h3>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center">@ViewBag.SuccessMessage</div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post">
            <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

            <div class="mb-3 text-start">
                <label class="form-label">Mật khẩu cũ:</label>
                <input type="password" name="oldPassword" class="form-control" required />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label">Mật khẩu mới:</label>
                <input type="password" name="newPassword" class="form-control" required />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label">Nhập lại mật khẩu mới:</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100" style="background-color: #512773; border: none;">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>