@model PetLuv.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập - Pet Luv";
}

<div class="container text-center" style="margin-top: 50px;">
    <div class="auth-card" style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); max-width: 450px; margin: 0 auto;">

        <h2 style="color: #512773; font-weight: bold; margin-bottom: 5px;">PET LUV</h2>
        <p style="color: #512773; font-weight: bold; margin-bottom: 25px;">ĐĂNG NHẬP</p>

        <div class="text-center mb-4">
            <p class="text-muted small">Hoặc đăng nhập nhanh bằng:</p>
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-outline-danger w-100 fw-bold" onclick="alert('Tính năng đang được cấu hình bảo mật trên Google Cloud!')">
                    <i class="bi bi-google"></i> Google
                </button>
                <button type="button" class="btn btn-outline-primary w-100 fw-bold" onclick="alert('Tính năng đang được cấu hình bảo mật trên Facebook Developers!')">
                    <i class="bi bi-facebook"></i> Facebook
                </button>
            </div>
        </div>

        <form asp-action="Login" method="post">
            @* Ô Nhập Email *@
            <input asp-for="Email" class="form-control" placeholder="SDT / EMAIL:"
                   style="background-color: #FFF1E8; border: none; border-radius: 50px; padding: 12px 20px; margin-bottom: 15px;" />

            @* Ô Nhập Mật khẩu *@
            <input asp-for="Password" type="password" class="form-control" placeholder="MẬT KHẨU:"
                   style="background-color: #FFF1E8; border: none; border-radius: 50px; padding: 12px 20px; margin-bottom: 5px;" />

            <div class="text-end mb-3" style="padding-right: 10px;">
                <a asp-controller="Account" asp-action="ForgotPassword" class="text-muted small text-decoration-none">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn w-100"
                    style="background-color: #FFC55C; color: #274753; font-weight: bold; border-radius: 50px; padding: 12px 40px; margin-top: 10px;">
                ĐĂNG NHẬP
            </button>
        </form>

        <div class="mt-4">
            <a asp-action="Register" style="color: #512773; font-weight: bold; text-decoration: none; font-size: 0.95rem;">ĐĂNG KÝ TÀI KHOẢN MỚI</a>
        </div>
    </div>
</div>