@model PetLuv.Models.User
@{
    ViewData["Title"] = "Thông tin cá nhân - PetLuv";
}

<div class="container mt-5" style="max-width: 600px; font-family: 'Inter', sans-serif;">
    <div class="card shadow border-0 p-4" style="border-radius: 20px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #512773;">👤 THÔNG TIN CÁ NHÂN</h2>
            <p class="text-muted">Boss có thể kiểm tra hoặc thay đổi thông tin của mình tại đây nha!</p>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center fw-bold border-0 shadow-sm mb-4" style="border-radius: 10px;">
                @ViewBag.SuccessMessage
            </div>
        }

        <form asp-action="Profile" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold" style="color: #512773;">Địa chỉ Email tài khoản</label>
                <input asp-for="Email" class="form-control bg-light" readonly style="border-radius: 10px;" />
                <div class="form-text text-muted">Email dùng làm tên đăng nhập cố định và không thể chỉnh sửa.</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Họ và tên của Boss</label>
                <input type="text" name="fullName" value="@Model.FullName" class="form-control" required style="border-radius: 10px;" />
            </div>

            <div class="d-flex gap-3">
                <a href="/" class="btn btn-secondary w-100 fw-bold py-2" style="border-radius: 10px;">Quay lại trang chủ</a>
                <button type="submit" class="btn text-white w-100 fw-bold py-2" style="background-color: #512773; border-radius: 10px;">Lưu cập nhật</button>
            </div>
        </form>
    </div>
</div>