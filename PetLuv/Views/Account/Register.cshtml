@model PetLuv.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký - Pet Luv";
}

<div class="container text-center" style="margin-top: 50px;">
    <div class="auth-card" style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); max-width: 450px; margin: 0 auto;">

        <h2 style="color: #512773; font-weight: bold;">PET LUV</h2>
        <p style="color: #512773; font-weight: bold;">ĐĂNG KÝ</p>

        <form asp-action="Register" method="post">
            @* Ô Nhập tên *@
            <input asp-for="FullName" class="form-control" placeholder="TÊN KHÁCH HÀNG:"
                   style="background-color: #FFF1E8; border: none; border-radius: 50px; padding: 12px 20px; margin-bottom: 15px;" />

            @* Ô Nhập Email *@
            <input asp-for="Email" class="form-control" placeholder="EMAIL / SỐ ĐIỆN THOẠI:"
                   style="background-color: #FFF1E8; border: none; border-radius: 50px; padding: 12px 20px; margin-bottom: 15px;" />

            @* Ô Nhập Mật khẩu *@
            <input asp-for="Password" type="password" class="form-control" placeholder="MẬT KHẨU:"
                   style="background-color: #FFF1E8; border: none; border-radius: 50px; padding: 12px 20px; margin-bottom: 15px;" />

            @* Ô Nhập lại Mật khẩu *@
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="NHẬP LẠI MẬT KHẨU:"
                   style="background-color: #FFF1E8; border: none; border-radius: 50px; padding: 12px 20px; margin-bottom: 15px;" />

            <button type="submit" class="btn"
                    style="background-color: #FFC55C; color: #274753; font-weight: bold; border-radius: 50px; padding: 10px 40px; margin-top: 15px;">
                ĐĂNG KÝ
            </button>
        </form>
    </div>
</div>