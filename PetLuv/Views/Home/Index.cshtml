@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container text-center mx-auto my-5 py-4" style="max-width: 950px;">
    <h1 class="fw-extrabold mb-3" style="color: #512773; font-size: 3rem; font-weight: 800; letter-spacing: 1px;">
        🐾 PET LUV
    </h1>
    <p class="fw-semibold text-muted mb-4 px-3" style="font-size: 1.4rem; line-height: 1.8; color: #5c436e !important;">
        Chào mừng bạn đến với thiên đường mua sắm và dinh dưỡng cao cấp dành cho các boss! 💖 <br>
        Tại <span style="color: #512773; font-weight: 800;">PetLuv</span>, chúng mình chuyên cung cấp các dòng
        <span class="badge bg-white px-2 py-1 shadow-sm" style="color: #512773; border: 1px solid #512773;">Thức ăn hạt hữu cơ</span> chính hãng,
        <span class="badge bg-white px-2 py-1 shadow-sm" style="color: #512773; border: 1px solid #512773;">Thực phẩm dinh dưỡng</span> giàu dưỡng chất
        và các phụ kiện độc đáo nhất cho thú cưng của bạn. Cam kết mang đến những sản phẩm an toàn, chất lượng vượt trội để người bạn bốn chân luôn khỏe mạnh và tràn đầy năng lượng!
    </p>

    <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
        <span class="badge rounded-pill bg-warning text-dark px-4 py-3 shadow-sm" style="font-size: 1.05rem; font-weight: 700; letter-spacing: 0.5px;">🌿 100% CHÍNH HÃNG</span>
        <span class="badge rounded-pill text-white px-4 py-3 shadow-sm" style="background-color: #512773; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.5px;">✨ ĐỦ DINH DƯỠNG</span>
        <span class="badge rounded-pill bg-info text-white px-4 py-3 shadow-sm" style="font-size: 1.05rem; font-weight: 700; letter-spacing: 0.5px;">🚚 GIAO NHANH CHÓNG</span>
    </div>
</div>

<section class="service">
    <div class="service-card text-center p-3">
        <div class="fs-1 mb-2">🌿</div>
        <h3>100% Chính Hãng</h3>
        <p>Cam kết thức ăn, hạt dinh dưỡng nhập khẩu chính ngạch, rõ ràng nguồn gốc xuất xứ.</p>
    </div>

    <div class="service-card text-center p-3">
        <div class="fs-1 mb-2">🥦</div>
        <h3>Chuẩn Dinh Dưỡng</h3>
        <p>Giàu Protein và khoáng chất, giúp các Boss phát triển khỏe mạnh toàn diện từ bên trong.</p>
    </div>

    <div class="service-card text-center p-3">
        <div class="fs-1 mb-2">🚚</div>
        <h3>Giao Hàng Siêu Tốc</h3>
        <p>Ship nhanh nội thành, đóng gói cẩn thận để bữa ăn của boss không bao giờ bị chậm trễ.</p>
    </div>

    <div class="service-card text-center p-3">
        <div class="fs-1 mb-2">💖</div>
        <h3>Tư Vấn Tận Tâm</h3>
        <p>Đội ngũ PetLuv luôn sẵn sàng hỗ trợ chọn dòng hạt và phụ kiện phù hợp nhất cho từng bé.</p>
    </div>
</section>

<h2 class="section-title mt-5">🌟 Thức Ăn Hạt Dinh Dưỡng</h2>
<section class="product mb-5">
    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="1">
            <img src="~/images/products/1-hat-cho-adult-smartheart.jpg" alt="SmartHeart">
            <h3>SmartHeart Adult Dog Food</h3>
            <p>100.000đ / 400g</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="1" class="btn-add-cart">Thêm vào giỏ</a>
    </div>

    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="2">
            <img src="~/images/products/2-hat-cho-anf-vi-cuu.jpg" alt="ANF">
            <h3>Hạt hữu cơ ANF 6 vị cừu</h3>
            <p>99.000đ / 400g</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="2" class="btn-add-cart">Thêm vào giỏ</a>
    </div>

    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="3">
            <img src="~/images/products/3-hat-cho-con-royal-canin.jpg" alt="Royal Canin">
            <h3>Royal Canin Mini Puppy</h3>
            <p>185.000đ / 800g</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="3" class="btn-add-cart">Thêm vào giỏ</a>
    </div>

    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="4">
            <img src="~/images/products/4-hat-cho-con-today-dinner.jpg" alt="Today Dinner">
            <h3>Today's Dinner Puppy</h3>
            <p>350.000đ / 5kg</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="4" class="btn-add-cart">Thêm vào giỏ</a>
    </div>
</section>

<h2 class="section-title mt-5">🧸 Phụ Kiện Cưng Xỉu Cho Boss</h2>

<div id="phuKienCarousel" class="carousel slide container mt-4" data-bs-ride="carousel" style="max-width: 1050px;">
    <div class="carousel-inner p-2">

        <div class="carousel-item active">
            <div class="p-5 text-center rounded-4 shadow-sm" style="background: linear-gradient(135deg, #FFF3CD 0%, #F3EFFF 100%); border: 1px dashed #B497D6;">
                <span class="badge bg-danger mb-2" style="font-size: 0.85rem; padding: 6px 12px; border-radius: 50px;">Coming Soon ✨</span>
                <h3 class="fw-bold" style="color: #512773;">🥣 Bát Ăn Chống Sặc & Đồ Chơi Gặm Nướu</h3>
                <p class="text-muted mx-auto my-3" style="max-width: 650px; font-size: 1.05rem;">
                    Tụi mình đang chuẩn bị cập bến những mẫu bát ăn bảo vệ cột sống và đồ chơi dây thừng bền bỉ giúp Boss giảm căng thẳng khi Sen vắng nhà.
                </p>
                <button class="btn text-white px-4 py-2 rounded-pill fw-bold" style="background-color: #512773; border: none;" onclick="alert('Hệ thống đang cập nhật sản phẩm mới, Sen quay lại sau nhen! 🐾')">
                    Nhận thông báo khi có hàng 🔔
                </button>
            </div>
        </div>

        <div class="carousel-item">
            <div class="p-5 text-center rounded-4 shadow-sm" style="background: linear-gradient(135deg, #E3F2FD 0%, #FFEFF2 100%); border: 1px dashed #B497D6;">
                <span class="badge bg-warning text-dark mb-2" style="font-size: 0.85rem; padding: 6px 12px; border-radius: 50px;">New Collection 🌟</span>
                <h3 class="fw-bold" style="color: #512773;">🔔 Vòng Cổ Định Danh & Kìm Cắt Móng LED</h3>
                <p class="text-muted mx-auto my-3" style="max-width: 650px; font-size: 1.05rem;">
                    Giúp cuộc sống của các Boss thêm phần chanh sả và an toàn với bộ phụ kiện vòng cổ chuông sắc màu cùng dụng cụ vệ sinh chuyên dụng.
                </p>
                <button class="btn text-white px-4 py-2 rounded-pill fw-bold" style="background-color: #512773; border: none;" onclick="alert('Hệ thống đang cập nhật sản phẩm mới, Sen quay lại sau nhen! 🐾')">
                    Đặt trước nhận ưu đãi 10% 🎁
                </button>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#phuKienCarousel" data-bs-slide="prev" style="width: 5%;">
        <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true" style="filter: invert(1);"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#phuKienCarousel" data-bs-slide="next" style="width: 5%;">
        <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true" style="filter: invert(1);"></span>
    </button>
</div>

<h2 class="section-title mt-5">💡 Góc Chia Sẻ Nhà PetLuv</h2>
<div class="container my-4" style="max-width: 1100px;">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="p-4 rounded-4 shadow-sm h-100" style="background-color: #FFF9E6; border-left: 5px solid #FFC107;">
                <h5 class="fw-bold" style="color: #512773;">🥣 Cho Boss ăn hạt đúng cách như thế nào?</h5>
                <p class="text-muted m-0 small" style="line-height: 1.6;">
                    Nên chia nhỏ thành 2-3 bữa một ngày tùy theo độ tuổi. Đặc biệt, đừng quên chuẩn bị một bát nước sạch kế bên vì hạt khô cần lượng nước lớn để Boss tiêu hóa tốt và không lo các bệnh về thận nhen các Sen!
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-4 rounded-4 shadow-sm h-100" style="background-color: #F3EFFF; border-left: 5px solid #6F42C1;">
                <h5 class="fw-bold" style="color: #512773;">🧸 Vì sao cần sắm đủ các món phụ kiện cơ bản?</h5>
                <p class="text-muted m-0 small" style="line-height: 1.6;">
                    Vòng cổ định danh giúp bảo vệ Boss, bát ăn điều tiết tốc độ giúp chống sặc, đồ chơi gặm nướu giúp giảm stress khi Sen vắng nhà... Những món phụ kiện nhỏ này chính là chìa khóa giúp cuộc sống của Boss hạnh phúc hơn!
                </p>
            </div>
        </div>
    </div>
</div>