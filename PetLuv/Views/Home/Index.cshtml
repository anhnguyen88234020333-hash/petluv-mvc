@{
    ViewData["Title"] = "Trang chủ";
}

<section class="banner">
    <img src="~/images/banner/banner.png" alt="banner">
</section>

<section class="service">
    <div class="service-card">
        <img src="~/images/services/spa-1.jpg" alt="">
        <h3>Pet Spa & Grooming</h3>
        <p>Chăm sóc và làm đẹp thú cưng chuyên nghiệp.</p>
    </div>

    <div class="service-card">
        <img src="~/images/services/spa-2.jpg" alt="">
        <h3>Chăm sóc thú cưng</h3>
        <p>Giúp thú cưng luôn sạch sẽ và khỏe mạnh.</p>
    </div>

    <div class="service-card">
        <img src="~/images/services/hotel-1.jpg" alt="">
        <h3>Pet Hotel</h3>
        <p>Lưu trú an toàn, chăm sóc 24/7.</p>
    </div>

    <div class="service-card">
        <img src="~/images/services/hotel-2.jpg" alt="">
        <h3>Giữ thú cưng</h3>
        <p>Môi trường sạch sẽ, thoải mái.</p>
    </div>
</section>

<h2 class="section-title">Sản phẩm nổi bật</h2>

<section class="product">
    <div class="product-card">
        <a href="#">
            <img src="~/images/products/1-hat-cho-adult-smartheart.jpg" alt="SmartHeart">
            <h3>SmartHeart Adult Dog Food</h3>
            <p>100.000đ / 1.5kg</p>
        </a>
        <button>Thêm vào giỏ</button>
    </div>

    <div class="product-card">
        <a href="#">
            <img src="~/images/products/2-hat-cho-anf-vi-cuu.jpg" alt="ANF">
            <h3>Hạt hữu cơ ANF 6 vị cừu</h3>
            <p>99.000đ / 400g</p>
        </a>
        <button>Thêm vào giỏ</button>
    </div>

    <div class="product-card">
        <a href="#">
            <img src="~/images/products/3-hat-cho-con-royal-canin.jpg" alt="Royal Canin">
            <h3>Royal Canin Mini Puppy</h3>
            <p>185.000đ / 800g</p>
        </a>
        <button>Thêm vào giỏ</button>
    </div>

    <div class="product-card">
        <a href="#">
            <img src="~/images/products/4-hat-cho-con-today-dinner.jpg" alt="Today Dinner">
            <h3>Today's Dinner Puppy</h3>
            <p>350.000đ / 5kg</p>
        </a>
        <button>Thêm vào giỏ</button>
    </div>
</section>