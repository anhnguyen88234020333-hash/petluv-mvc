@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container text-center mx-auto my-5 py-4" style="max-width: 950px;">
    <h1 class="fw-extrabold mb-3" style="color: #512773; font-size: 3rem; font-weight: 800; letter-spacing: 1px;">
        🐾 PET LUV
    </h1>
    <p class="fw-semibold text-muted mb-4 px-3" style="font-size: 1.4rem; line-height: 1.8; color: #5c436e !important;">
        Chào mừng bạn đến với thiên đường mua sắm và dinh dưỡng cao cấp dành cho các boss! 💖 <br>
        Tại <span style="color: #512773; font-weight: 800;">PetLuv</span>, chúng mình chuyên cung cấp các dòng
        <span class="badge bg-white px-2 py-1 shadow-sm" style="color: #512773; border: 1px solid #512773;">Thức ăn hạt hữu cơ</span> chính hãng,
        <span class="badge bg-white px-2 py-1 shadow-sm" style="color: #512773; border: 1px solid #512773;">Thực phẩm dinh dưỡng</span> giàu dưỡng chất
        và các phụ kiện độc đáo nhất cho thú cưng của bạn. Cam kết mang đến những sản phẩm an toàn, chất lượng vượt trội để người bạn bốn chân luôn khỏe mạnh và tràn đầy năng lượng!
    </p>

    <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
        <span class="badge rounded-pill bg-warning text-dark px-4 py-3 shadow-sm" style="font-size: 1.05rem; font-weight: 700; letter-spacing: 0.5px;">🌿 100% CHÍNH HÃNG</span>
        <span class="badge rounded-pill text-white px-4 py-3 shadow-sm" style="background-color: #512773; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.5px;">✨ ĐỦ DINH DƯỠNG</span>
        <span class="badge rounded-pill bg-info text-white px-4 py-3 shadow-sm" style="font-size: 1.05rem; font-weight: 700; letter-spacing: 0.5px;">🚚 GIAO NHANH CHÓNG</span>
    </div>
</div>

<section class="service">
    <div class="service-card">
        <img src="~/images/services/spa-1.jpg" alt="Chính hãng">
        <h3>100% Chính Hãng</h3>
        <p>Cam kết thức ăn, hạt dinh dưỡng nhập khẩu chính ngạch, an toàn tuyệt đối.</p>
    </div>

    <div class="service-card">
        <img src="~/images/services/spa-2.jpg" alt="Dinh dưỡng">
        <h3>Chuẩn Dinh Dưỡng</h3>
        <p>Sản phẩm được chọn lọc kỹ càng, giúp boss phát triển khỏe mạnh toàn diện.</p>
    </div>

    <div class="service-card">
        <img src="~/images/services/hotel-1.jpg" alt="Giao hàng">
        <h3>Giao Hàng Siêu Tốc</h3>
        <p>Ship nhanh nội thành, đóng gói cẩn thận để bữa ăn của boss không bị chậm trễ.</p>
    </div>

    <div class="service-card">
        <img src="~/images/services/hotel-2.jpg" alt="Hỗ trợ">
        <h3>Tư Vấn Tận Tâm</h3>
        <p>Đội ngũ PetLuv luôn sẵn sàng hỗ trợ chọn dòng hạt phù hợp nhất cho từng bé.</p>
    </div>
</section>

<h2 class="section-title">Sản phẩm nổi bật</h2>

<section class="product">
    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="1">
            <img src="~/images/products/1-hat-cho-adult-smartheart.jpg" alt="SmartHeart">
            <h3>SmartHeart Adult Dog Food</h3>
            <p>100.000đ / 400g</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="1" class="btn-add-cart">Thêm vào giỏ</a>
    </div>

    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="2">
            <img src="~/images/products/2-hat-cho-anf-vi-cuu.jpg" alt="ANF">
            <h3>Hạt hữu cơ ANF 6 vị cừu</h3>
            <p>99.000đ / 400g</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="2" class="btn-add-cart">Thêm vào giỏ</a>
    </div>

    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="3">
            <img src="~/images/products/3-hat-cho-con-royal-canin.jpg" alt="Royal Canin">
            <h3>Royal Canin Mini Puppy</h3>
            <p>185.000đ / 800g</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="3" class="btn-add-cart">Thêm vào giỏ</a>
    </div>

    <div class="product-card">
        <a asp-controller="Product" asp-action="Details" asp-route-id="4">
            <img src="~/images/products/4-hat-cho-con-today-dinner.jpg" alt="Today Dinner">
            <h3>Today's Dinner Puppy</h3>
            <p>350.000đ / 5kg</p>
        </a>
        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="4" class="btn-add-cart">Thêm vào giỏ</a>
    </div>
</section>