@model IEnumerable<PetLuv.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h2 class="fw-bold position-relative d-inline-block pb-2" style="color: #512773; font-size: 2.5rem; font-weight: 800;">
            🐾 CỬA HÀNG PETLUV
            <span class="position-absolute bottom-0 start-50 translate-middle-x bg-warning" style="height: 4px; width: 80px; border-radius: 2px;"></span>
        </h2>
        <p class="text-muted mt-2 fs-5">Khám phá thế giới thức ăn dinh dưỡng cao cấp tốt nhất cho các boss cưng</p>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-5" style="border-radius: 15px; background-color: #F5EEF9;">
        <form method="get" asp-controller="Product" asp-action="Index" class="row g-3 align-items-center">

            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-0 text-muted" style="border-radius: 12px 0 0 12px;"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-0 py-2 ps-1" placeholder="Nhập tên sản phẩm cần tìm..." value="@ViewBag.SearchTerm" style="border-radius: 0 12px 12px 0; font-size: 0.95rem;" />
                </div>
            </div>

            <div class="col-md-4">
                <select name="priceRange" class="form-select border-0 py-2" style="border-radius: 12px; font-size: 0.95rem; color: #512773; font-weight: 600;">
                    <option value="">-- Chọn khoảng giá mong muốn --</option>
                    <option value="under100" selected="@(ViewBag.SelectedPrice == "under100" ? "selected" : null)">Dưới 100.000đ</option>
                    <option value="100to200" selected="@(ViewBag.SelectedPrice == "100to200" ? "selected" : null)">100.000đ - 200.000đ</option>
                    <option value="over200" selected="@(ViewBag.SelectedPrice == "over200" ? "selected" : null)">Trên 200.000đ</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn text-white w-100 py-2 fw-bold shadow-sm" style="background-color: #512773; border-radius: 12px;">
                    <i class="bi bi-funnel-fill"></i> Lọc kết quả
                </button>
                <a asp-action="Index" class="btn btn-light border w-50 py-2 fw-bold text-muted" style="border-radius: 12px;">
                    <i class="bi bi-arrow-clockwise"></i> Xóa
                </a>
            </div>

        </form>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <h4 class="text-muted"><i class="bi bi-emoji-frown fs-2"></i> Không tìm thấy sản phẩm nào khớp với bộ lọc rồi bae ơi!</h4>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm custom-product-card" style="border-radius: 20px; overflow: hidden; background-color: #ffffff; transition: all 0.3s ease;">

                        <a asp-action="Details" asp-route-id="@item.ProductID" class="d-block text-center p-3 bg-light position-relative" style="height: 240px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(item.ImageURL))
                            {
                                <img src="@Url.Content(item.ImageURL)" alt="@item.ProductName" class="
-fluid custom-card-img" style="max-height: 190px; object-fit: contain; transition: transform 0.3s ease;" />
                            }
                            else
                            {
                                <div class="text-muted small"><i class="bi bi-image"></i> Không có ảnh</div>
                            }
                            <span class="badge position-absolute px-3 py-2 bg-danger rounded-pill fw-bold" style="font-size: 0.75rem; top: 15px; left: 15px;">Chính hãng 🌿</span>
                        </a>

                        <div class="card-body d-flex flex-column p-4">
                            <a asp-action="Details" asp-route-id="@item.ProductID" class="text-decoration-none" style="color: #333;">
                                <h5 class="card-title fw-bold mb-2 text-truncate-2" style="font-size: 1.1rem; min-height: 50px; line-height: 1.4;">
                                    @item.ProductName
                                </h5>
                            </a>

                            <p class="card-text text-muted small text-truncate-2 mb-3" style="font-size: 0.85rem; min-height: 38px;">
                                @item.Description
                            </p>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-extrabold fs-5 text-danger" style="font-weight: 800;">
                                        @item.Price.ToString("N0") VNĐ
                                    </span>
                                </div>

                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@item.ProductID" class="btn w-100 py-2 fw-bold text-white shadow-sm custom-btn-cart" style="background-color: #512773; border-radius: 12px; transition: all 0.3s; font-size: 0.95rem;">
                                    <i class="bi bi-cart-plus-fill me-1"></i> Thêm vào giỏ
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    /* Ép chữ tiêu đề ngắt dòng thông minh khi tên sản phẩm quá dài */
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Hiệu ứng zoom nhẹ hình ảnh và nổi khối Card khi di chuột vào */
    .custom-product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 25px rgba(81, 39, 115, 0.15) !important;
    }

        .custom-product-card:hover .custom-card-img {
            transform: scale(1.06);
        }

    /* Tạo hiệu ứng chuyển màu cho nút Thêm vào giỏ hàng */
    .custom-btn-cart:hover {
        background-color: #ffc107 !important;
        color: #512773 !important;
        box-shadow: 0 4px 10px rgba(255, 193, 7, 0.3) !important;
    }
</style>